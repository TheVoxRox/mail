{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true
	},
	// $app/tsconfig brings the compiler options but neither list: SvelteKit 3
	// leaves include and exclude to the project.
	"include": ["src", "vite.config.ts", "playwright.config.ts"],
	"exclude": ["node_modules", "build", ".svelte-kit/output"]
}
