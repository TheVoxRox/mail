{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"src/routes/**/+{page,layout,server,error}.{svelte,ts,js}!",
		"src/app.html!",
		"src/lib/api/type-contract.ts!",
		"src/routes/**/*.e2e.ts",
		"src/test-fixtures/msw/worker.ts",
		// Listed individually, and the line is load-bearing: beta-channel.yml runs
		// this as `node frontend/scripts/beta-channel-guard.mjs` from the repo root,
		// while knip runs with cwd frontend/, so its GitHub Actions plugin cannot
		// resolve that path. Every other script is reached through package.json, an
		// import, or the vitest include - which is why scripts/** is not an entry
		// glob here. Drop this line and knip reports the guard as an unused file.
		//
		// knip models package.json and workflows, not PowerShell: a script invoked
		// only from a .ps1 (backend/scripts/ has two that call into here) would be
		// reported as unused and belongs on this list too, not deleted.
		"scripts/beta-channel-guard.mjs",
		// Same reason: release-candidate-smoke.yml runs these two from workflow
		// steps that knip does not resolve to a path.
		"scripts/installed-app-smoke.mjs",
		"scripts/installed-app-update-smoke.mjs",
		// And release-channel-check.yml runs this one.
		"scripts/verify-channel-manifest.mjs",
		// The .ps1 case above: backend/scripts/package-sidecar-windows.ps1 runs
		// this one to record the backend source digest in the sidecar image.
		"scripts/print-backend-source-digest.mjs",
		"playwright.existing-server.config.ts"
	],
	"project": [
		"src/**/*.{ts,svelte}!",
		"!src/test-fixtures/**!",
		"!src/routes/e2e-helpers.ts!",
		"!src/routes/a11y-target.ts!",
		"scripts/**/*.{mjs,ts,js}"
	],
	"ignore": ["src/test-stubs/**"],
	"ignoreDependencies": ["openapi-typescript"],
	// `$app` is not a package: `svelte-kit sync` writes node_modules/$app itself,
	// and tsconfig.json extends $app/tsconfig from it, as SvelteKit 3 has it.
	// Since knip 6.45 a tsconfig `extends` that resolves into node_modules is
	// credited to the package named by the file's path, and reported unlisted
	// when package.json does not name it; 6.44 reported no config input as
	// unlisted. ignoreDependencies cannot take it: knip names the package from
	// the path, but its ignore filter skips any name that does not start like an
	// npm package, and `$` does not. The SvelteKit plugin's `$app/` ignore covers
	// imports from source (unresolved), not this. The cost: an unlisted package
	// named in tsconfig's `types` or `plugins` would go unreported too; it names
	// none. Drop this once knip credits `$app/tsconfig` itself. knip does not
	// report an ignoreIssues pattern that matches nothing, so check by deleting
	// the line and running `npm run knip`.
	"ignoreIssues": { "tsconfig.json": ["unlisted"] },
	"ignoreBinaries": ["pwsh", "icacls"],
	"ignoreExportsUsedInFile": true
}
