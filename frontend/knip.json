{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"entry": [
		"src/routes/**/+{page,layout,server,error}.{svelte,ts,js}!",
		"src/app.html!",
		"src/lib/api/type-contract.ts!",
		"src/routes/**/*.e2e.ts",
		"src/test-fixtures/msw/worker.ts",
		// Listed individually, and the line is load-bearing: beta-channel.yml runs
		// this as `node frontend/scripts/beta-channel-guard.mjs` from the repo root,
		// while knip runs with cwd frontend/, so its GitHub Actions plugin cannot
		// resolve that path. Every other script is reached through package.json, an
		// import, or the vitest include - which is why scripts/** is not an entry
		// glob here. Drop this line and knip reports the guard as an unused file.
		//
		// knip models package.json and workflows, not PowerShell: a script invoked
		// only from a .ps1 (backend/scripts/ has two that call into here) would be
		// reported as unused and belongs on this list too, not deleted.
		"scripts/beta-channel-guard.mjs",
		"playwright.existing-server.config.ts"
	],
	"project": [
		"src/**/*.{ts,svelte}!",
		"!src/test-fixtures/**!",
		"!src/routes/e2e-helpers.ts!",
		"!src/routes/a11y-target.ts!",
		"scripts/**/*.{mjs,ts,js}"
	],
	"ignore": ["src/lib/api/generated.ts", "src/test-stubs/**"],
	"ignoreDependencies": ["openapi-typescript", "tw-animate-css"],
	"ignoreBinaries": ["pwsh", "icacls"],
	"ignoreExportsUsedInFile": true
}
